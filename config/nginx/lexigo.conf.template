log_format lexigo escape=json
    '{"time":"$time_iso8601","status":$status,"seconds":$request_time,"bytes":$body_bytes_sent}';
server_tokens off;
ssl_protocols TLSv1.2 TLSv1.3;

server {
    listen 80 default_server;
    server_name _;
    access_log /dev/stdout lexigo;
    error_log /dev/stderr crit;
    return 421;
}

server {
    listen 80;
    server_name ${LEXIGO_HOST};
    access_log /dev/stdout lexigo;
    error_log /dev/stderr crit;
    return 308 https://${LEXIGO_HOST}$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;
    access_log /dev/stdout lexigo;
    error_log /dev/stderr crit;
    ssl_reject_handshake on;
    return 421;
}

server {
    listen 443 ssl;
    server_name ${LEXIGO_HOST};
    access_log /dev/stdout lexigo;
    error_log /dev/stderr crit;
    ssl_certificate /etc/lexigo/tls/fullchain.pem;
    ssl_certificate_key /etc/lexigo/tls/privkey.pem;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 11m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:" always;

    location ^~ /api/ {
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Forwarded "";
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
    }

    location = /api { return 404; }
    location ^~ /health/ { return 404; }
    location ^~ /swagger { return 404; }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        expires -1;
        try_files $uri =404;
    }

    location = /index.html {
        expires -1;
    }

    location ~ (^|/)\. {
        return 404;
    }

    location ~ \.[^/]+$ {
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
